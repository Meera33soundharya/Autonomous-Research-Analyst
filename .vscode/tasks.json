{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Streamlit app",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"streamlit",
				"run",
				"app.py",
				"--server.address",
				"127.0.0.1",
				"--server.port",
				"8501"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}
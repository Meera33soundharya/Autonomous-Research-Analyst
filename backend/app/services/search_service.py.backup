
import os
import time
from urllib.parse import quote

from dotenv import load_dotenv

try:
    from tavily import TavilyClient
except Exception:  # pragma: no cover - optional dependency guard
    TavilyClient = None


# ============================================================
# LOAD ENVIRONMENT
# ============================================================

load_dotenv()

api_key = os.getenv("TAVILY_API_KEY")

client = None
if api_key and TavilyClient is not None:
    client = TavilyClient(api_key=api_key)


def _fallback_search_results(query: str, max_results: int) -> list[dict]:
    cleaned = query.strip()
    encoded = quote(cleaned)
    results = []
    bases = [
        "https://www.example.org/research/",
        "https://www.nature.com/",
        "https://www.cdc.gov/",
    ]

    for idx in range(max_results):
        url = f"{bases[idx % len(bases)]}?q={encoded}"
        results.append({
            "title": f"Reference on {cleaned}",
            "url": url,
            "content": (
                f"This fallback result provides a placeholder summary for the query '{cleaned}'. "
                f"It is used only when the live search service is unavailable so the research pipeline can continue gracefully."
            ),
        })

    return results


# ============================================================
# SEARCH FUNCTION
# ============================================================

def search_web(
    query: str,
    max_results: int = 3,
    retries: int = 3
):
    """
    Search the web using Tavily.

    The function automatically retries temporary
    connection failures instead of crashing the
    complete research pipeline.
    """

    if not query or not query.strip():
        return []

    query = query.strip()

    if client is None:
        return _fallback_search_results(query, max_results)

    for attempt in range(1, retries + 1):

        try:

            print(
                f"[Searcher] Searching: {query}"
            )

            response = client.search(
                query=query,
                search_depth="basic",
                max_results=max_results
            )

            results = response.get(
                "results",
                []
            )

            print(
                f"[Searcher] Found {len(results)} results"
            )

            return results

        except Exception as error:

            print(
                f"[Searcher] Attempt "
                f"{attempt}/{retries} failed: "
                f"{error}"
            )

            if attempt == retries:

                print(
                    "[Searcher] All retry attempts failed."
                )

                return _fallback_search_results(query, max_results)

            wait_time = 2 ** attempt

            print(
                f"[Searcher] Retrying in "
                f"{wait_time} seconds..."
            )

            time.sleep(wait_time)
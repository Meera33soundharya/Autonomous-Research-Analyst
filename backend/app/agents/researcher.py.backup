from app.services.llm_service import ask_llm


def analyze_sources(
    question: str,
    sources: list[dict]
) -> dict:

    question_sources = [
        source
        for source in sources
        if source.get("question") == question
    ]

    if not question_sources:
        question_sources = sources

    source_blocks = []

    for index, source in enumerate(
        question_sources,
        1
    ):

        content = source.get(
            "content",
            ""
        )

        if len(content) > 7000:
            content = content[:7000]

        source_blocks.append(
            f"""
SOURCE {index}
Title: {source.get("title", "")}
URL: {source.get("url", "")}
Source Quality: {source.get("source_quality", 0)}

CONTENT:
{content}
"""
        )

    joined_sources = "\n".join(
        source_blocks
    )

    prompt = f"""
You are the Evidence Researcher Agent.

RESEARCH QUESTION:
{question}

You are given only the sources collected for this research question.

SOURCE MATERIAL:
{joined_sources}

TASK:
Extract 2 to 5 important factual findings that directly answer
the research question.

STRICT RULES:

1. Use ONLY the supplied source material.
2. Never use outside knowledge.
3. Never invent facts.
4. Never invent numbers.
5. Never invent dates.
6. Never invent statistics.
7. Every finding must be directly supported by its assigned source.
8. Do not combine multiple sources into one claim.
9. Each claim must contain one clear factual statement.
10. Do not make predictions unless a source explicitly makes that prediction.
11. Preserve important numbers and dates exactly.
12. Use the source number that actually supports the claim.

RETURN ONLY THIS FORMAT:

FINDING | SOURCE_NUMBER | CLAIM

Example:

FINDING | 1 | The study reports that ...
FINDING | 3 | The report found that ...

Do not return explanations.
Do not return headings.
Do not return markdown.
"""

    response = ask_llm(
        prompt
    )

    findings = []

    for line in response.splitlines():

        line = line.strip()

        if not line:
            continue

        if line.startswith(
            "FINDING"
        ):
            parts = line.split(
                "|",
                2
            )

            if len(parts) != 3:
                continue

            try:
                source_number = int(
                    parts[1].strip()
                )
            except ValueError:
                continue

            claim = parts[2].strip()

            if not claim:
                continue

            if not (
                1 <= source_number <= len(question_sources)
            ):
                continue

            source = question_sources[
                source_number - 1
            ]

            findings.append(
                {
                    "claim": claim,
                    "source_number": source_number,
                    "source_title": source.get(
                        "title",
                        ""
                    ),
                    "source_url": source.get(
                        "url",
                        ""
                    ),
                    "source_content": source.get(
                        "content",
                        ""
                    ),
                    "source_quality": source.get(
                        "source_quality",
                        0
                    )
                }
            )

    return {
        "question": question,
        "findings": findings
    }
